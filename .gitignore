# Dependencies — restored by `npm ci` in the deploy workflow
node_modules/

# Build output — GitHub Actions builds this from source on every push to main.
# Committing it only guarantees a stale copy in the repo.
site/dist/
# Intermediate SSR bundle: prerender.js imports it, then it's dead. Never shipped.
site/dist-ssr/

# macOS
.DS_Store

# Machine-specific tool config — absolute local paths, not for a public repo
.mcp.json
.claude/settings.local.json

# Derived knowledge graph (graphify skill output)
graphify-out/

# Env files and local overrides — nothing uses them today; insurance for a public repo
.env*
*.local
*.log
